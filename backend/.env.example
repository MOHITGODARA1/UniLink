# ============================================
# Performance-Optimized Environment Variables
# ============================================

# DATABASE CONFIGURATION
MONGO_DB=mongodb+srv://user:password@cluster.mongodb.net/unilink?retryWrites=true&w=majority

# PERFORMANCE TUNING
# Bcrypt cost factor (rounds):
# - Development/Testing: 8-10 (faster hashing, lower security)
# - Production: 12-14 (slower hashing, higher security)
# Formula: Each +1 takes ~2x longer
# At cost 10: ~10ms per hash
# At cost 12: ~40ms per hash
# At cost 14: ~160ms per hash
BCRYPT_COST=10

# NODE ENVIRONMENT
NODE_ENV=development

# JWT SECRETS (update these in production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=7d

# CORS ORIGINS (comma-separated)
CORS_ORIGINS=http://localhost:5173,https://unilink-1.onrender.com

# SERVER PORT
PORT=5001

# ============================================
# SCALING RECOMMENDATIONS
# ============================================

# For 100-500 VUs:
# - Use BCRYPT_COST=10
# - Connection pool: maxPoolSize=10

# For 500-1000 VUs:
# - Use BCRYPT_COST=8 (faster but less secure, only for load testing)
# - Connection pool: maxPoolSize=20
# - Consider Redis caching: REDIS_URL=redis://localhost:6379

# For 1000+ VUs:
# - Implement Queue system (Bull/RabbitMQ)
# - Use BCRYPT_COST=8 for signup (defer security checks)
# - Connection pool: maxPoolSize=50
# - Enable read replicas for duplicate checks
# - Implement rate limiting and circuit breakers
